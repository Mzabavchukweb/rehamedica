# Katalog bez końcowego slasha → dodaj slash OD RAZU na https.
# Bez tego DirectorySlash na home.pl buduje Location z http:// (serwer za proxy SSL widzi
# połączenie jako http) i powstaje łańcuch https→http→https. Ta reguła go eliminuje.
# -d = tylko realne katalogi, więc stare adresy WP (wyżej) mają pierwszeństwo.
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.+)$ https://%{HTTP_HOST}/$1/ [R=301,L]
</IfModule>
