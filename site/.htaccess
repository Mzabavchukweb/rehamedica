<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Stara sitemapa WordPressa (index + podsitemapy) → nowa. Google przejdzie płynnie
# zamiast dostawać 404 na zapamiętanym z WP adresie wp-sitemap*.xml.
RewriteRule ^wp-sitemap.*\.xml$ https://rehamedica.info.pl/sitemap.xml [R=301,L]

# ── Projekty UE zdjęte z serwisu 2026-08-03 (decyzja właściciela: nie realizujemy
#    już takich projektów). Trzy strony zniknęły, więc stare adresy muszą oddawać
#    301 zamiast 404 — były indeksowane i linkowane ze stopki każdej podstrony.
RewriteRule ^projekty-ue/projekt-mindspots/?$ https://rehamedica.info.pl/aktualnosci/ [R=301,L]
RewriteRule ^projekty-ue/zakonczenie-postepowania-ofertowego-komputery-mindspots/?$ https://rehamedica.info.pl/aktualnosci/ [R=301,L]
RewriteRule ^projekty-ue/?$ https://rehamedica.info.pl/aktualnosci/ [R=301,L]

